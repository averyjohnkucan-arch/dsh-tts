{
  "name": "dsh-tts",
  "version": "0.1.0",
  "description": "Local Audio8 text-to-speech for DeepSeek Harness: searchable TTS, long-text chunking and inline audio playback.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "lib",
    "scripts",
    "README.md",
    "LICENSE",
    "VALIDATION.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js",
    "setup": "python3 scripts/setup.py",
    "smoke": "node scripts/smoke.mjs",
    "check:discovery": "node scripts/check-discovery.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/averyjohnkucan-arch/dsh-tts.git"
  }
}
